# Apify API Token
# Get it at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Apify Actor ID for Threads Scraper
# Default actor: apidojo/threads-scraper
APIFY_ACTOR_ID=apidojo/threads-scraper

# Anthropic Claude API Key
# Get it at: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Bot Token
# Get it from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ1234567890

# Telegram Chat ID where notifications will be sent
# Use @userinfobot to find your chat ID
TELEGRAM_CHAT_ID=-1001234567890

# Minimum lead score (1-10) to send to Telegram
MIN_SCORE=6

# How often to check for new posts (in minutes)
CHECK_INTERVAL_MINUTES=10

# SQLite database file path
DB_PATH=./data/leads.db

# Max posts per Apify run (to control costs)
APIFY_MAX_ITEMS=50

# Log level: debug, info, warn, error
LOG_LEVEL=info
